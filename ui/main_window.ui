       </layout>
      </widget>

      <!-- Tab 1: PLC 状态 -->
      <widget class="QWidget" name="tabPlc">
       <attribute name="title"><string>PLC 状态</string></attribute>
       <layout class="QVBoxLayout" name="plcLayout">
        <item>
